{
  "属性定义": {
    "hp": {
      "ID": "hp",
      "属性名": "血量",
      "缩写": "HP",
      "分类": "核心",
      "说明": "归零即判负",
      "默认值": 100,
      "最小": 1,
      "最大": 9999,
      "战斗可见": "是",
      "备注": null
    },
    "sta": {
      "ID": "sta",
      "属性名": "耐力",
      "缩写": "STA",
      "分类": "核心",
      "说明": "每次出手消耗",
      "默认值": 50,
      "最小": 0,
      "最大": 999,
      "战斗可见": "是",
      "备注": "归零进入力竭状态"
    },
    "atk": {
      "ID": "atk",
      "属性名": "攻击",
      "缩写": "ATK",
      "分类": "核心",
      "说明": "伤害基数",
      "默认值": 12,
      "最小": 1,
      "最大": 999,
      "战斗可见": "是",
      "备注": "实际伤害=ATK×招式系数×减伤"
    },
    "arm": {
      "ID": "arm",
      "属性名": "护甲",
      "缩写": "ARM",
      "分类": "核心",
      "说明": "百分比减伤",
      "默认值": 20,
      "最小": 0,
      "最大": 999,
      "战斗可见": "是",
      "备注": "减伤=ARM/(ARM+ARM_K)"
    },
    "spd": {
      "ID": "spd",
      "属性名": "速度",
      "缩写": "SPD",
      "分类": "核心",
      "说明": "出手频率",
      "默认值": 20,
      "最小": 1,
      "最大": 200,
      "战斗可见": "是",
      "备注": "间隔=基础间隔×100/(100+SPD)"
    },
    "sta_regen": {
      "ID": "sta_regen",
      "属性名": "耐力回复",
      "缩写": "REG",
      "分类": "派生",
      "说明": "每秒回复耐力",
      "默认值": 6,
      "最小": 0,
      "最大": 99,
      "战斗可见": "是",
      "备注": "决定续航"
    },
    "crit": {
      "ID": "crit",
      "属性名": "暴击",
      "缩写": "CRIT",
      "分类": "派生",
      "说明": "暴击率(%)",
      "默认值": 5,
      "最小": 0,
      "最大": 100,
      "战斗可见": "是",
      "备注": "倍率见战斗常数"
    },
    "tough": {
      "ID": "tough",
      "属性名": "韧性",
      "缩写": "TGH",
      "分类": "派生",
      "说明": "降低被暴击(%)",
      "默认值": 0,
      "最小": 0,
      "最大": 100,
      "战斗可见": "是",
      "备注": null
    },
    "pen": {
      "ID": "pen",
      "属性名": "破甲",
      "缩写": "PEN",
